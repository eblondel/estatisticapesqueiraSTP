# ----------------  STEP 3: RUNNING KOBOMANAGER  --------------- #
shiny::observe({
shiny::req(rv$proc)
shiny::invalidateLater(100, session)
if(file.exists(rv$log_file)){
rv$log <- readLines(rv$log_file, warn = FALSE)
}
if(!rv$proc$is_alive()){
rv$running <- FALSE
rv$proc <- NULL
}
})
output$log_output <- shiny::renderText({
paste(rv$log, collapse = "\n")
})
}
